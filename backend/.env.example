NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://plaschema:plaschema@localhost:5432/plaschema
REDIS_URL=redis://localhost:6379
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173
SWAGGER_ENABLED=true
JWT_SECRET=cbhi-dev-jwt-secret-change-me
JWT_EXPIRES_IN=8h
SEED_ADMIN_EMAIL=admin@cbhi.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Root Admin

# Object Storage (Railway Buckets / S3-compatible)
OBJECT_STORAGE_PROVIDER=railway
OBJECT_STORAGE_BUCKET_NAME=your-bucket-name
OBJECT_STORAGE_ENDPOINT=https://t3.storageapi.dev
OBJECT_STORAGE_ACCESS_KEY_ID=your-access-key-id
OBJECT_STORAGE_SECRET_ACCESS_KEY=your-secret-access-key
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_PRESIGN_TTL_SECONDS=1800

# Capitation (NGN per active beneficiary)
CAPITATION_RATE=700
