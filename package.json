{
  "name": "plaschema",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm infra:up && pnpm --parallel --filter frontend --filter backend --filter pwa dev",
    "dev:all": "pnpm dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend infra:up && pnpm --filter backend dev",
    "dev:pwa": "pnpm --filter pwa dev",
    "infra:up": "pnpm --filter backend infra:up",
    "infra:down": "pnpm --filter backend infra:down",
    "build": "pnpm --filter frontend build && pnpm --filter backend build && pnpm --filter pwa build",
    "build:frontend": "pnpm --filter frontend build",
    "build:backend": "pnpm --filter backend build",
    "build:pwa": "pnpm --filter pwa build",
    "lint": "pnpm --filter frontend lint && pnpm --filter backend lint && pnpm --filter pwa lint",
    "lint:frontend": "pnpm --filter frontend lint",
    "lint:backend": "pnpm --filter backend lint",
    "lint:pwa": "pnpm --filter pwa lint",
    "preview": "pnpm --filter frontend preview",
    "test:backend": "pnpm --filter backend test",
    "test:pwa": "pnpm --filter pwa test",
    "typecheck:backend": "pnpm --filter backend typecheck",
    "prisma:generate": "pnpm --filter backend prisma:generate",
    "prisma:validate": "pnpm --filter backend prisma:validate",
    "prisma:migrate:dev": "pnpm --filter backend prisma:migrate:dev",
    "prisma:migrate:deploy": "pnpm --filter backend prisma:migrate:deploy",
    "prisma:seed": "pnpm --filter backend prisma:seed",
    "prisma:studio": "pnpm --filter backend prisma:studio"
  }
}
