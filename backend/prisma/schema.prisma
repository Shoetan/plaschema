generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  field_worker
}

enum UserStatus {
  active
  inactive
}

enum EnrollmentTitle {
  mr
  mrs
  miss
  ms
  dr
  chief
  rev
  alhaji
  hajia
  other
}

enum EnrollmentGender {
  male
  female
}

enum MaritalStatus {
  single
  married
  divorced
  widowed
  separated
}

enum BloodGroup {
  a_pos
  a_neg
  b_pos
  b_neg
  ab_pos
  ab_neg
  o_pos
  o_neg
  unknown
}

enum Genotype {
  aa
  as
  ss
  ac
  sc
  unknown
}

enum IdDocumentType {
  nin
  national_id
  voters_card
  drivers_license
  international_passport
  other
}

enum NextOfKinRelationship {
  spouse
  parent
  sibling
  child
  relative
  friend
  other
}

enum EnrollmentStatus {
  pending
  active
  disabled
  deceased
}

enum WardStatus {
  active
  inactive
}

enum HealthFacilityStatus {
  active
  inactive
}

enum HealthFacilityLevel {
  primary
  secondary
  tertiary
}

enum ActivityCategory {
  enrollment
  ward
  user
  sync
}

enum ActivityAction {
  created
  updated
  status_changed
  printed
  assigned
}

enum FileJobKind {
  id_card
  enrollment_report
}

enum FileJobFormat {
  pdf
  xlsx
}

enum FileJobStatus {
  queued
  processing
  failed
  completed
}

model Ward {
  id        String     @id @db.Uuid
  name      String     @unique
  lga       String
  status    WardStatus @default(active)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  assignments      UserWardAssignment[]
  healthFacilities HealthFacility[]
  enrollments      Enrollment[]
  activityLogs     ActivityLog[]

  @@index([status])
  @@index([lga])
}

model User {
  id           String     @id @db.Uuid
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole
  status       UserStatus @default(active)
  phone        String?
  /// Last successful offline/mobile sync reported by the client app.
  lastSyncedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  assignedWards  UserWardAssignment[]
  enrollments    Enrollment[]         @relation("EnrollmentEnrolledBy")
  activityLogs   ActivityLog[]        @relation("ActivityLogActor")
  capitationRuns CapitationRun[]
  fileJobs       FileJob[]
}

model UserWardAssignment {
  userId    String   @db.Uuid
  wardId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  ward Ward @relation(fields: [wardId], references: [id], onDelete: Restrict)

  @@id([userId, wardId])
  @@index([wardId])
}

model HealthFacility {
  id        String               @id @db.Uuid
  name      String
  /// Denormalized from ward.lga for filtering/legacy batch upload compatibility.
  lga       String
  type      String               @default("Primary Health Care")
  level     HealthFacilityLevel  @default(primary)
  status    HealthFacilityStatus @default(active)
  wardId    String               @db.Uuid
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  ward               Ward                @relation(fields: [wardId], references: [id], onDelete: Restrict)
  enrollments        Enrollment[]
  capitationRecords  CapitationRecord[]

  @@unique([name, wardId])
  @@index([wardId])
  @@index([lga])
  @@index([status])
  @@index([type])
  @@index([level])
}

model CapitationRun {
  id              String   @id @db.Uuid
  month           Int
  year            Int
  rate            Int
  createdAt       DateTime @default(now())
  createdByUserId String   @db.Uuid

  createdBy User               @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  records   CapitationRecord[]

  @@index([year, month, createdAt(sort: Desc)])
}

model CapitationRecord {
  id               String @id @db.Uuid
  runId            String @db.Uuid
  healthFacilityId String @db.Uuid
  facilityName     String
  lga              String
  beneficiaryCount Int
  rate             Int
  amount           Int

  run            CapitationRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  healthFacility HealthFacility   @relation(fields: [healthFacilityId], references: [id], onDelete: Restrict)

  @@index([runId])
  @@index([healthFacilityId])
}

model EnrollmentYearCounter {
  year      Int @id
  lastValue Int
}

model Enrollment {
  id String @id @db.Uuid

  /// Human-readable enrollment ID, e.g. PL/CBHI/2026/001
  enrollmentId String @unique

  /// Client-generated idempotency key for offline-first sync retries.
  idempotencyId String @unique @db.Uuid

  /// When the enrollment was captured on-device (may precede server createdAt).
  capturedAt DateTime?

  status EnrollmentStatus @default(pending)

  /// Beneficiary category as shown in admin tables (e.g. IDPs, Elderly 65+).
  category String

  enrolledByUserId String @db.Uuid
  wardId           String @db.Uuid
  healthFacilityId String @db.Uuid

  passportObjectKey   String
  idDocumentObjectKey String

  title      EnrollmentTitle
  gender     EnrollmentGender
  firstName  String
  lastName   String
  middleName String?

  /// Lowercased collapsed names used for duplicate detection with dateOfBirth.
  firstNameNormalized String
  lastNameNormalized  String

  dateOfBirth   DateTime @db.Date
  phone         String
  email         String?
  nin           String?
  maritalStatus MaritalStatus
  bloodGroup    BloodGroup?
  genotype      Genotype?
  idType        IdDocumentType

  nextOfKinFullName      String?
  emergencyPhone         String?
  nextOfKinRelationship  NextOfKinRelationship?

  stateOfResidence  String @default("Plateau")
  lgaOfResidence    String
  residentialAddress String

  /// When the beneficiary ID card was last printed (null = never printed).
  printedAt  DateTime?
  /// How many times an ID card has been generated/printed for this enrollment.
  printCount Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrolledBy     User           @relation("EnrollmentEnrolledBy", fields: [enrolledByUserId], references: [id], onDelete: Restrict)
  ward           Ward           @relation(fields: [wardId], references: [id], onDelete: Restrict)
  healthFacility HealthFacility @relation(fields: [healthFacilityId], references: [id], onDelete: Restrict)
  activityLogs   ActivityLog[]

  @@unique([firstNameNormalized, lastNameNormalized, dateOfBirth], map: "enrollment_identity_key")
  @@index([wardId])
  @@index([healthFacilityId])
  @@index([enrolledByUserId])
  @@index([createdAt])
  @@index([status])
  @@index([category])
  @@index([printedAt])
}

model ActivityLog {
  id           String           @id @db.Uuid
  category     ActivityCategory
  action       ActivityAction
  summary      String
  wardId       String           @db.Uuid
  actorUserId  String?          @db.Uuid
  enrollmentId String?          @db.Uuid
  metadata     Json?
  occurredAt   DateTime         @default(now())

  ward       Ward        @relation(fields: [wardId], references: [id], onDelete: Restrict)
  actor      User?       @relation("ActivityLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  @@index([wardId, occurredAt(sort: Desc)])
  @@index([wardId, category, occurredAt(sort: Desc)])
  @@index([enrollmentId])
}

model FileJob {
  id                String         @id @db.Uuid
  requestedByUserId String         @db.Uuid
  kind              FileJobKind
  format            FileJobFormat
  status            FileJobStatus  @default(queued)
  /// Sort helper: queued=0, processing=1, failed=2, completed=3
  statusRank        Int            @default(0)
  title             String
  objectKey         String?
  error             String?
  metadata          Json?
  createdAt         DateTime       @default(now())
  startedAt         DateTime?
  completedAt       DateTime?

  requestedBy User @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@index([requestedByUserId, statusRank, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status])
}
